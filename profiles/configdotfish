# UTF-8 encoding
set -gx LANG 'en_US.UTF-8'
set -gx LC_ALL 'en_US.UTF-8'

# Keybindings — interactive shells only
if status --is-interactive
    bind \cu backward-kill-line
    bind \e kill-whole-line
    bind \e\[1\;3D backward-word
    bind \e\[1\;3C forward-word
    bind \e\[1\;5D backward-word
    bind \e\[1\;5C forward-word
    bind \e\x7f backward-kill-word
    bind \b backward-kill-word
    bind \e\[3\;5~ kill-word
    bind \e\[3\;3~ kill-word
end

# calver — print current CalVer timestamp (yyyy.M.dHHmm)
function calver
    set -l y (date +%Y)
    set -l m (date +%m)
    set -l d (date +%d)
    set -l hm (date +%H%M)
    set -l m (string trim -l -c 0 $m)
    set -l d (string trim -l -c 0 $d)
    printf '%s.%s.%s%s\n' $y $m $d $hm
end

# new_credential — interactive credential prompt
# Result stored in __CREDENTIAL_USER and __CREDENTIAL_PASS
function new_credential
    printf '\nFish credential request\nEnter your credentials.\n\n'
    read -P 'User: ' user
    read -s -P "Password for user $user: " pass
    printf '\n'
    set -gx __CREDENTIAL_USER $user
    set -gx __CREDENTIAL_PASS $pass
end

# Custom prompt — rebuilt before each prompt via fish_prompt
function fish_prompt
    set -l git_branch (git rev-parse --abbrev-ref HEAD 2>/dev/null)
    set -l path_display (string replace -r '^'"$HOME"'' '~' $PWD)
    set -l branch_str ''
    if test -n "$git_branch"
        set branch_str " [$git_branch]"
    end
    set -l gt ''
    set -l shlvl_depth $SHLVL
    if status --is-login; and test $shlvl_depth -gt 1
        set shlvl_depth (math $shlvl_depth - 1)
    end
    for i in (seq 1 $shlvl_depth)
        set gt "$gt>"
    end
    printf '\n[%sx%s] %s%s\nfish%s ' $COLUMNS $LINES $path_display $branch_str $gt
end

# get_ip_address — cross-platform IP address retrieval
function get_ip_address
    if test (uname -s) = Darwin
        for i in (ifconfig -l | string split ' ')
            if test "$i" = lo0
                continue
            end
            set -l ip (ifconfig $i 2>/dev/null | awk '/inet [1-9]/{print $2; exit}')
            if test -n "$ip"
                printf '%s: %s\n' $i $ip
            end
        end
    else if command -v ip >/dev/null 2>&1
        ip addr show | awk '
            /^[0-9]+: / {
                split($2, a, "@")
                iface = a[1]
                sub(/:$/, "", iface)
            }
            /inet [1-9]/ && iface != "lo" {
                addr = $2
                sub(/\/.*/, "", addr)
                print iface ": " addr
            }
        '
    else
        printf '[!] No IP address retrieval method found.\n' >&2
    end
end

# gai — install Jake's global agent instructions, agents, skills, and hooks
function __gai_fetch
    curl -fsSL --connect-timeout 10 --create-dirs -o $argv[2] $argv[1]
end

# Fetch an instruction file and strip its YAML frontmatter.
function __gai_instr
    set -l tmp (mktemp); or return 1
    __gai_fetch $argv[1] $tmp; or begin
        rm -f $tmp
        return 1
    end
    mkdir -p (dirname $argv[2]); and awk 'NR==1&&/^---[[:space:]]*$/{f=1;next} f&&/^---[[:space:]]*$/{f=0;next} !f' $tmp > $argv[2]
    set -l rc $status
    rm -f $tmp
    return $rc
end

# Copy src to dst; back dst up first when its content would change.
function __gai_put
    set -l src $argv[1]
    set -l dst $argv[2]
    if test -e $dst; and test (path resolve $src) = (path resolve $dst)
        return 0
    end
    mkdir -p (dirname $dst); or return 1
    if test -e $dst
        cmp -s $src $dst; and return 0
        cp $dst $dst.bak.$__GAI_TS; or return 1
    end
    cp $src $dst; or return 1
    string match -q '*.sh' -- $dst; and chmod +x $dst
    set -g __GAI_CHANGED (math $__GAI_CHANGED + 1)
    return 0
end

function __gai_copytree
    set -l srcdir (string trim -r -c / -- $argv[1])
    set -l dstdir $argv[2]
    test -d $srcdir; or return 0
    for f in (find -L $srcdir -type f ! -name '*.bak.*' ! -name .DS_Store)
        __gai_put $f $dstdir/(string replace -- "$srcdir/" '' $f); or return 1
    end
    return 0
end

# Replace (or append) the managed block in a shared markdown file.
function __gai_block
    set -l target $argv[1]
    set -l body $argv[2]
    set -l new (mktemp); or return 1
    begin
        printf '<!-- BEGIN gai (managed block; edits here are overwritten) -->\n'
        cat $body
        printf '\n<!-- END gai -->\n'
    end > $new.blk
    if test -f $target; and grep -q '<!-- BEGIN gai' $target
        awk -v blk=$new.blk '/<!-- BEGIN gai/{while((getline l<blk)>0)print l; skip=1; next} /<!-- END gai -->/{skip=0; next} !skip' $target > $new
    else if test -f $target
        begin
            cat $target
            printf '\n'
            cat $new.blk
        end > $new
    else
        cp $new.blk $new
    end
    __gai_put $new $target
    set -l rc $status
    rm -f $new $new.blk
    return $rc
end

# shortcut: assumes jq output is one "<repo path><TAB><dest path>" per line; a truncated tree fails the source.
function __gai_fetch_listed
    set -l repo $argv[1]
    set -l filter $argv[2]
    set -l dest $argv[3]
    set -l tf (mktemp); or return 1
    curl -fsSL --connect-timeout 10 -H 'Accept: application/vnd.github+json' -o $tf "https://api.github.com/repos/$repo/git/trees/HEAD?recursive=1"; or begin
        rm -f $tf
        return 1
    end
    test (jq -r '.truncated' $tf) = false; or begin
        rm -f $tf
        return 1
    end
    set -l list (jq -r $filter $tf)
    set -l rc $status
    rm -f $tf
    test $rc -eq 0; and test (count $list) -gt 0; or return 1
    for line in $list
        set -l p (string split \t -- $line)
        __gai_fetch https://raw.githubusercontent.com/$repo/HEAD/$p[1] $dest/$p[2]; or return 1
    end
    return 0
end

function __gai_src_own
    set -l s $argv[1]
    set -l own https://raw.githubusercontent.com/jakehildreth/jakehildreth/HEAD
    __gai_instr $own/.github/copilot-instructions.md $s/instructions/personal.md; or return 1
    for f in no-ai-attribution.json no-ai-attribution.sh no-ai-attribution.ps1 no-squash-merge.json no-squash-merge.sh no-squash-merge.ps1
        __gai_fetch $own/hooks/$f $s/hooks/$f; or return 1
    end
    __gai_fetch_listed jakehildreth/jakehildreth '.tree[]|select(.type=="blob")|.path as $p|select($p|test("^skills/(conference-talk-summary|new-linkedin-post|talk-developer|writing-voice)/"))|"\($p)\t\($p|ltrimstr("skills/"))"' $s/skills
end

function __gai_src_awesome
    set -l s $argv[1]
    set -l a https://raw.githubusercontent.com/github/awesome-copilot/HEAD
    __gai_instr $a/instructions/powershell.instructions.md $s/instructions/powershell.md; or return 1
    __gai_instr $a/instructions/powershell-pester-6.instructions.md $s/instructions/pester.md; or return 1
    __gai_instr $a/instructions/csharp.instructions.md $s/instructions/csharp.md; or return 1
    for f in CSharpExpert.agent.md csharp-dotnet-janitor.agent.md
        __gai_fetch $a/agents/$f $s/agents/$f; or return 1
    end
    for f in pester-migration/SKILL.md pester-migration/references/v3-to-v4.md pester-migration/references/v4-to-v5.md pester-migration/references/v5-to-v6.md csharp-docs/SKILL.md
        __gai_fetch $a/skills/$f $s/skills/$f; or return 1
    end
end

function __gai_src_pocock
    __gai_fetch_listed mattpocock/skills '.tree[]|select(.type=="blob")|.path as $p|($p|capture("^skills/(?:engineering|productivity)/(?<r>[^/]+/.+)$")?)|"\($p)\t\(.r)"' $argv[1]/skills
end

function __gai_src_ponytail
    __gai_fetch_listed DietrichGebert/ponytail '.tree[]|select(.type=="blob")|.path as $p|($p|capture("^skills/(?<r>[^/]+/SKILL\\\\.md)$")?)|"\($p)\t\(.r)"' $argv[1]/skills
end

# Fetch a source into a temp dir; write it to ~/.agents only if every fetch worked.
function __gai_run
    set -l stage (mktemp -d); or return 1
    set -l rc 0
    if $argv[2] $stage; and __gai_copytree $stage $HOME/.agents
        printf '[+] %s\n' $argv[1]
    else
        printf '[x] %s failed; skipped\n' $argv[1] >&2
        set rc 1
    end
    rm -rf $stage
    return $rc
end

# Copy from ~/.agents into each harness directory that already exists.
function __gai_distribute
    set -l inst $HOME/.agents/instructions
    for h in $HOME/.claude $HOME/.omp/agent $HOME/.copilot
        if test -d $h
            __gai_copytree $HOME/.agents/skills $h/skills; or return 1
        end
    end
    if test -d $HOME/.claude
        __gai_copytree $HOME/.agents/agents $HOME/.claude/agents; or return 1
    end
    if test -d $HOME/.copilot
        __gai_copytree $HOME/.agents/hooks $HOME/.copilot/hooks; or return 1
    end

    set -l body (mktemp); or return 1
    for n in personal powershell pester csharp
        if test -f $inst/$n.md
            begin
                cat $inst/$n.md
                printf '\n'
            end >> $body
        end
    end
    __gai_block $HOME/AGENTS.md $body
    if test -d $HOME/.claude
        set -l same 0
        if test -e $HOME/.claude/CLAUDE.md; and test (path resolve $HOME/.claude/CLAUDE.md) = (path resolve $HOME/AGENTS.md)
            set same 1
        end
        test $same -eq 0; and __gai_block $HOME/.claude/CLAUDE.md $body
    end
    if test -d $HOME/.omp/agent
        __gai_block $HOME/.omp/agent/AGENTS.md $body
    end
    rm -f $body

    if test -d $HOME/.copilot
        for n in personal powershell pester csharp
            test -f $inst/$n.md; or continue
            switch $n
                case personal
                    set apply '**/*'
                case powershell
                    set apply '**/*.ps1,**/*.psm1'
                case pester
                    set apply '**/*.Tests.ps1'
                case csharp
                    set apply '**/*.cs'
            end
            set -l f (mktemp); or return 1
            begin
                echo '---'
                echo "applyTo: '$apply'"
                echo '---'
                echo
                cat $inst/$n.md
            end > $f
            __gai_put $f $HOME/.copilot/instructions/$n.instructions.md
            rm -f $f
        end
    end
    return 0
end

function gai
    set -l rc 0
    command -q curl; or begin
        printf '[x] gai needs curl\n' >&2
        return 1
    end
    command -q jq; or begin
        printf '[x] gai needs jq (brew install jq / apt install jq)\n' >&2
        return 1
    end
    set -g __GAI_TS (date +%Y%m%d%H%M%S)
    set -g __GAI_CHANGED 0
    __gai_run 'jakehildreth: instructions, hooks, skills' __gai_src_own; or set rc 1
    __gai_run 'awesome-copilot: instructions, agents, skills' __gai_src_awesome; or set rc 1
    __gai_run 'mattpocock/skills' __gai_src_pocock; or set rc 1
    __gai_run 'DietrichGebert/ponytail' __gai_src_ponytail; or set rc 1
    __gai_distribute; or begin
        printf '[x] distribute failed\n' >&2
        set rc 1
    end
    printf '[i] %s file(s) written; replaced files are kept as *.bak.%s\n' $__GAI_CHANGED $__GAI_TS
    return $rc
end

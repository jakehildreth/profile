#region Self-Update
__dollarsign_autoupdate() {
    [[ -o interactive ]] || return 0
    bash <(curl -fsSL --connect-timeout 3 'https://raw.githubusercontent.com/jakehildreth/profile/refs/heads/main/installers/install.sh' 2>/dev/null)
}
__dollarsign_autoupdate
unset -f __dollarsign_autoupdate
#endregion Self-Update

# UTF-8 encoding
export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'

# zsh-autosuggestions — source from first known install location
for __zas_path in \
    "$(brew --prefix 2>/dev/null)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    '/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh' \
    '/usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh'; do
    [[ -f "$__zas_path" ]] && { source "$__zas_path"; break; }
done
unset __zas_path

# zsh-syntax-highlighting — must be sourced last among plugins
for __zsh_path in \
    "$(brew --prefix 2>/dev/null)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
    '/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh' \
    '/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh'; do
    [[ -f "$__zsh_path" ]] && { source "$__zsh_path"; break; }
done
unset __zsh_path

# Keybindings
bindkey '^U'      backward-kill-line      # Ctrl+U        — clear to start of line
bindkey '^[^['    kill-whole-line         # Escape Escape — clear line (safe; avoids breaking alt sequences)
bindkey '\e[1;3D' backward-word           # Alt+Left
bindkey '\e[1;3C' forward-word            # Alt+Right
bindkey '\e[1;5D' backward-word           # Ctrl+Left
bindkey '\e[1;5C' forward-word            # Ctrl+Right
bindkey '^[\177'  backward-kill-word      # Alt+Backspace
bindkey '^H'      backward-kill-word      # Ctrl+Backspace
bindkey '^[[3;5~' kill-word               # Ctrl+Delete
bindkey '^[[3;3~' kill-word               # Alt+Delete

# calver — print current CalVer timestamp (yyyy.M.dHHmm)
calver() {
    local y m d hm
    y="$(date +%Y)"
    m="$(date +%m)"
    d="$(date +%d)"
    hm="$(date +%H%M)"
    printf '%s.%s.%s%s\n' "$y" "${m#0}" "${d#0}" "$hm"
}

# new_credential — interactive credential prompt
# Result stored in __CREDENTIAL_USER and __CREDENTIAL_PASS
new_credential() {
    printf '\nZsh credential request\nEnter your credentials.\n\n'
    local user pass
    read -r "user?User: "
    read -rs "pass?Password for user ${user}: "
    printf '\n'
    export __CREDENTIAL_USER="$user"
    export __CREDENTIAL_PASS="$pass"
}

# Custom prompt — rebuilt before each prompt via precmd hook
autoload -Uz add-zsh-hook
__dollarsign_precmd() {
    local git_branch
    git_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
    local path_display="${PWD/#$HOME/~}"
    local branch_str=''
    [[ -n "$git_branch" ]] && branch_str=" [${git_branch}]"
    local gt=''
    local shlvl_depth=$SHLVL
    [[ -o login ]] && (( shlvl_depth > 1 )) && (( shlvl_depth-- ))
    local i
    for ((i = 0; i < shlvl_depth; i++)); do gt+='>'; done
    PROMPT=$'\n'"[${COLUMNS}"$'\xc3\x97'"${LINES}] ${path_display}${branch_str}"$'\n'"zsh${gt} "
}
add-zsh-hook precmd __dollarsign_precmd

# get_ip_address — cross-platform IP address retrieval
get_ip_address() {
    if [[ "$(uname -s)" == 'Darwin' ]]; then
        local i ip
        for i in ${(s: :)"$(ifconfig -l)"}; do
            [[ "$i" == 'lo0' ]] && continue
            ip="$(ifconfig "$i" 2>/dev/null | awk '/inet [1-9]/{print $2; exit}')"
            [[ -n "$ip" ]] && printf '%s: %s\n' "$i" "$ip"
        done
    elif command -v ip &>/dev/null; then
        ip addr show | awk '
            /^[0-9]+: / {
                split($2, a, "@")
                iface = a[1]
                sub(/:$/, "", iface)
            }
            /inet [1-9]/ && iface != "lo" {
                addr = $2
                sub(/\/.*/, "", addr)
                print iface ": " addr
            }
        '
    else
        printf '[!] No IP address retrieval method found.\n' >&2
    fi
}

# gai — install Jake's global agent instructions, agents, skills, and hooks
__gai_fetch() { curl -fsSL --connect-timeout 10 --create-dirs -o "$2" "$1"; }

# Fetch an instruction file and strip its YAML frontmatter.
__gai_instr() {
    local tmp
    tmp="$(mktemp)" || return 1
    __gai_fetch "$1" "$tmp" || { rm -f "$tmp"; return 1; }
    mkdir -p "$(dirname "$2")" && awk 'NR==1&&/^---[[:space:]]*$/{f=1;next} f&&/^---[[:space:]]*$/{f=0;next} !f' "$tmp" > "$2"
    local rc=$?
    rm -f "$tmp"
    return $rc
}

# Copy src to dst; back dst up first when its content would change.
__gai_put() {
    local src="$1" dst="$2"
    [[ "$src" -ef "$dst" ]] && return 0
    mkdir -p "$(dirname "$dst")" || return 1
    if [[ -e "$dst" ]]; then
        cmp -s "$src" "$dst" && return 0
        cp "$dst" "$dst.bak.$__GAI_TS" || return 1
    fi
    cp "$src" "$dst" || return 1
    [[ "$dst" == *.sh ]] && chmod +x "$dst"
    __GAI_CHANGED=$((__GAI_CHANGED + 1))
    return 0
}

__gai_copytree() {
    local srcdir="${1%/}" dstdir="$2" f
    [[ -d "$srcdir" ]] || return 0
    while IFS= read -r f; do
        __gai_put "$f" "$dstdir/${f#"$srcdir"/}" || return 1
    done < <(find -L "$srcdir" -type f ! -name '*.bak.*' ! -name '.DS_Store')
}

# Replace (or append) the managed block in a shared markdown file.
__gai_block() {
    local target="$1" body="$2" new rc
    new="$(mktemp)" || return 1
    { printf '<!-- BEGIN gai (managed block; edits here are overwritten) -->\n'; cat "$body"; printf '\n<!-- END gai -->\n'; } > "$new.blk"
    if [[ -f "$target" ]] && grep -q '<!-- BEGIN gai' "$target"; then
        awk -v blk="$new.blk" '/<!-- BEGIN gai/{while((getline l<blk)>0)print l; skip=1; next} /<!-- END gai -->/{skip=0; next} !skip' "$target" > "$new"
    elif [[ -f "$target" ]]; then
        { cat "$target"; printf '\n'; cat "$new.blk"; } > "$new"
    else
        cp "$new.blk" "$new"
    fi
    __gai_put "$new" "$target"
    rc=$?
    rm -f "$new" "$new.blk"
    return $rc
}

# shortcut: assumes jq output is one "<repo path><TAB><dest path>" per line; a truncated tree fails the source.
__gai_fetch_listed() {
    local repo="$1" filter="$2" dest="$3" tree list src rel
    tree="$(curl -fsSL --connect-timeout 10 -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$repo/git/trees/HEAD?recursive=1")" || return 1
    [[ "$(printf '%s' "$tree" | jq -r '.truncated')" == false ]] || return 1
    list="$(printf '%s' "$tree" | jq -r "$filter")" || return 1
    [[ -n "$list" ]] || return 1
    while IFS=$'\t' read -r src rel; do
        __gai_fetch "https://raw.githubusercontent.com/$repo/HEAD/$src" "$dest/$rel" || return 1
    done <<< "$list"
}

__gai_src_own() {
    local s="$1" own='https://raw.githubusercontent.com/jakehildreth/jakehildreth/HEAD' f
    __gai_instr "$own/.github/copilot-instructions.md" "$s/instructions/personal.md" || return 1
    for f in no-ai-attribution.json no-ai-attribution.sh no-ai-attribution.ps1 no-squash-merge.json no-squash-merge.sh no-squash-merge.ps1; do
        __gai_fetch "$own/hooks/$f" "$s/hooks/$f" || return 1
    done
    __gai_fetch_listed jakehildreth/jakehildreth '.tree[]|select(.type=="blob")|.path as $p|select($p|test("^skills/(conference-talk-summary|new-linkedin-post|talk-developer|writing-voice)/"))|"\($p)\t\($p|ltrimstr("skills/"))"' "$s/skills"
}

__gai_src_awesome() {
    local s="$1" a='https://raw.githubusercontent.com/github/awesome-copilot/HEAD' f
    __gai_instr "$a/instructions/powershell.instructions.md" "$s/instructions/powershell.md" || return 1
    __gai_instr "$a/instructions/powershell-pester-6.instructions.md" "$s/instructions/pester.md" || return 1
    __gai_instr "$a/instructions/csharp.instructions.md" "$s/instructions/csharp.md" || return 1
    for f in CSharpExpert.agent.md csharp-dotnet-janitor.agent.md; do
        __gai_fetch "$a/agents/$f" "$s/agents/$f" || return 1
    done
    for f in pester-migration/SKILL.md pester-migration/references/v3-to-v4.md pester-migration/references/v4-to-v5.md pester-migration/references/v5-to-v6.md csharp-docs/SKILL.md; do
        __gai_fetch "$a/skills/$f" "$s/skills/$f" || return 1
    done
}

__gai_src_pocock() {
    __gai_fetch_listed mattpocock/skills '.tree[]|select(.type=="blob")|.path as $p|($p|capture("^skills/(?:engineering|productivity)/(?<r>[^/]+/.+)$")?)|"\($p)\t\(.r)"' "$1/skills"
}

__gai_src_ponytail() {
    __gai_fetch_listed DietrichGebert/ponytail '.tree[]|select(.type=="blob")|.path as $p|($p|capture("^skills/(?<r>[^/]+/SKILL\\.md)$")?)|"\($p)\t\(.r)"' "$1/skills"
}

# Fetch a source into a temp dir; write it to ~/.agents only if every fetch worked.
__gai_run() {
    local stage rc=0
    stage="$(mktemp -d)" || return 1
    if "$2" "$stage" && __gai_copytree "$stage" "$HOME/.agents"; then
        printf '[+] %s\n' "$1"
    else
        printf '[x] %s failed; skipped\n' "$1" >&2
        rc=1
    fi
    rm -rf "$stage"
    return $rc
}

# Copy from ~/.agents into each harness directory that already exists.
__gai_distribute() {
    local h n apply body f
    local inst="$HOME/.agents/instructions"
    for h in "$HOME/.claude" "$HOME/.omp/agent" "$HOME/.copilot"; do
        [[ -d "$h" ]] && { __gai_copytree "$HOME/.agents/skills" "$h/skills" || return 1; }
    done
    [[ -d "$HOME/.claude" ]] && { __gai_copytree "$HOME/.agents/agents" "$HOME/.claude/agents" || return 1; }
    [[ -d "$HOME/.copilot" ]] && { __gai_copytree "$HOME/.agents/hooks" "$HOME/.copilot/hooks" || return 1; }

    body="$(mktemp)" || return 1
    for n in personal powershell pester csharp; do
        [[ -f "$inst/$n.md" ]] && { cat "$inst/$n.md"; printf '\n'; } >> "$body"
    done
    __gai_block "$HOME/AGENTS.md" "$body"
    [[ -d "$HOME/.claude" && ! "$HOME/.claude/CLAUDE.md" -ef "$HOME/AGENTS.md" ]] && __gai_block "$HOME/.claude/CLAUDE.md" "$body"
    [[ -d "$HOME/.omp/agent" ]] && __gai_block "$HOME/.omp/agent/AGENTS.md" "$body"
    rm -f "$body"

    if [[ -d "$HOME/.copilot" ]]; then
        for n in personal powershell pester csharp; do
            [[ -f "$inst/$n.md" ]] || continue
            case "$n" in
                personal)   apply='**/*' ;;
                powershell) apply='**/*.ps1,**/*.psm1' ;;
                pester)     apply='**/*.Tests.ps1' ;;
                csharp)     apply='**/*.cs' ;;
            esac
            f="$(mktemp)" || return 1
            { printf -- "---\napplyTo: '%s'\n---\n\n" "$apply"; cat "$inst/$n.md"; } > "$f"
            __gai_put "$f" "$HOME/.copilot/instructions/$n.instructions.md"
            rm -f "$f"
        done
    fi
    return 0
}

gai() {
    local rc=0
    command -v curl >/dev/null || { printf '[x] gai needs curl\n' >&2; return 1; }
    command -v jq >/dev/null || { printf '[x] gai needs jq (brew install jq / apt install jq)\n' >&2; return 1; }
    __GAI_TS="$(date +%Y%m%d%H%M%S)"
    __GAI_CHANGED=0
    __gai_run 'jakehildreth: instructions, hooks, skills' __gai_src_own || rc=1
    __gai_run 'awesome-copilot: instructions, agents, skills' __gai_src_awesome || rc=1
    __gai_run 'mattpocock/skills' __gai_src_pocock || rc=1
    __gai_run 'DietrichGebert/ponytail' __gai_src_ponytail || rc=1
    __gai_distribute || { printf '[x] distribute failed\n' >&2; rc=1; }
    printf '[i] %s file(s) written; replaced files are kept as *.bak.%s\n' "$__GAI_CHANGED" "$__GAI_TS"
    return $rc
}

